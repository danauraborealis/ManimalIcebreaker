<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Manimal.Icebreaker.Server</RootNamespace>
    <AssemblyName>icebreaker-server</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Authors>$(ModUsername)</Authors>
    <Version>$(ModVersion)</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(SPTPath)\SPT_Runtime\0Harmony.dll</HintPath>

    <Private>false</Private></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(SPTPath)\SPT_Runtime\SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SPTPath)\SPT_Runtime\SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SPTPath)\SPT_Runtime\SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WTT-ServerCommonLib"><HintPath>$(SPTPath)\SPT_Runtime\user\mods\WTT-ServerCommonLib\WTT-ServerCommonLib.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!--
    deploy dll + db + bundles.json into the dev SPT mod folder. the two BUNDLE files
    (615MB scenes + preset) are NOT copied per-build — stage those once by hand or
    with the deploy script; a rebuild only refreshes dll/json.
  -->
  <Target Condition="'$(DeployToGame)' == 'true'" Name="PostBuild" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <DevModDir>$(SPTPath)\SPT_Runtime\user\mods\ManimalIcebreaker</DevModDir>
    </PropertyGroup>
    <ItemGroup>
      <DbFiles Include="$(ProjectDir)db\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(DevModDir)" />
    <Copy SourceFiles="@(DbFiles)" DestinationFiles="@(DbFiles->'$(DevModDir)\db\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(ProjectDir)bundles.json" DestinationFolder="$(DevModDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DevModDir)" />
  </Target>

  <!-- the FULL release (single zip, BepInEx + SPT + EscapeFromTarkov_Data trees) is
       built by package-release.ps1 at the repo root -->


  <ItemGroup><Reference Include="SemanticVersioning"><HintPath>$(SPTPath)\SPT_Runtime\SemanticVersioning.dll</HintPath><Private>false</Private></Reference></ItemGroup>
</Project>
