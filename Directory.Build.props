<Project>
  <!-- single source of truth for version + identity, per manimal mod conventions -->
  <PropertyGroup>
    <ModVersion>0.3.1</ModVersion>
    <ModGuid>com.manimal.icebreaker</ModGuid>
    <ModUsername>Manimal</ModUsername>
    <ModDisplayName>Icebreaker</ModDisplayName>

  </PropertyGroup>
  <!-- Override SPTPath with an installed SPT 4.1.3 root. DeployToGame remains opt-in. -->
  <PropertyGroup><SPTPath Condition="'$(SPTPath)' == ''">$(MSBuildThisFileDirectory)..\..</SPTPath></PropertyGroup>
  <PropertyGroup><FikaPath Condition="'$(FikaPath)' == ''">$(SPTPath)</FikaPath></PropertyGroup>
  <PropertyGroup><FikaPath Condition="'$(FikaPath)' == ''">$(SPTPath)</FikaPath></PropertyGroup>
  <PropertyGroup><FikaPath Condition="'$(FikaPath)' == ''">$(SPTPath)</FikaPath></PropertyGroup>
</Project>
